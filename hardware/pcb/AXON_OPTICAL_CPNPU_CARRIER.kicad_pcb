  )
  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (layer "F.Cu")
    (at 62.5 62.5)
    (pad "1" thru_hole circle (at 0 0) (size 5.0 5.0) (drill 2.7) (layers *.Cu *.Mask) (net 1 "GND"))
  )
  (footprint "MountingHole:MountingHole_2.7mm_M2.5_Pad_Via" (layer "F.Cu")
