(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.6)
  )

  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" power "GND")
    (2 "In2.Cu" power "PWR")
    (3 "In3.Cu" signal "SIG_INNER")
    (4 "In4.Cu" power "GND_SHIELD")
    (31 "B.Cu" signal)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
