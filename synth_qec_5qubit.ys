# The 0-MUL gate MUST run before `synth` - see synth_qec_3qubit.ys for the
# measured reason (an assertion after synth passes even on `a * b`).
read_verilog D:/axon-양자기술/rtl/qec_decoder_5qubit_0mul.v
hierarchy -top qec_decoder_5qubit_0mul
proc
# No `opt` here on purpose - see synth_qec_3qubit.ys.
select -assert-none t:$mul
design -reset

read_verilog D:/axon-양자기술/rtl/qec_decoder_5qubit_0mul.v
synth -top qec_decoder_5qubit_0mul -flatten
abc
stat
ltp -noff
abc -lut 4
stat

